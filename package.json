{
  "name": "nian-vision",
  "private": true,
  "version": "1.0.0-rc.49",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter nian-ui dev",
    "build": "pnpm --filter nian-ui build",
    "lint": "pnpm --filter nian-ui lint",
    "typecheck": "pnpm --filter nian-ui typecheck",
    "test": "pnpm --filter nian-ui test",
    "release:test": "node --test scripts/release/*.test.mjs",
    "release:version": "node scripts/release/version-check.mjs"
  }
}
